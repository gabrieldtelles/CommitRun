# Banco de dados (obrigatorio em producao)
# Neon Postgres: https://neon.tech  — copie a connection string com sslmode=require
# Em desenvolvimento, sem esta variavel a aplicacao usa um Postgres em memoria.
DATABASE_URL=

# Login com GitHub (obrigatorio para jogar)
# Crie um OAuth App em https://github.com/settings/developers (aba OAuth Apps)
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Gere com: npx auth secret
AUTH_SECRET=

# Em producao, informe a URL publica do site.
# AUTH_URL=https://seu-dominio.vercel.app
