# Login com GitHub (opcional). Sem estas variaveis o jogo funciona, mas o botao de entrar some.
# Crie um OAuth App em https://github.com/settings/developers
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Gere com: npx auth secret   (ou openssl rand -base64 32)
AUTH_SECRET=

# Em producao, informe a URL publica do site.
# AUTH_URL=https://seu-dominio.vercel.app

# Persistencia do ranking e do progresso por conta (opcional).
# Sem isto tudo funciona, mas os dados ficam so na instancia em memoria.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
